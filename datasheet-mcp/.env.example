# Copy to .env and customize. All values optional — defaults target STM32F407 RM0090.

# --- Pick your PDF ---
DATASHEET_PDF=pdfs/RM0090.pdf

# --- Identity (shown to Claude in tool descriptions) ---
DATASHEET_NAME=STM32F407 reference manual (RM0090)
DATASHEET_SHORT=STM32F407
DATASHEET_DESCRIPTION=STM32F407 microcontroller peripherals, registers, clock trees, DMA, interrupts.

# --- Vector DB table name (change if hosting multiple manuals) ---
DATASHEET_TABLE=datasheet

# --- Register parser: comma-separated list of peripheral prefixes ---
# STM32 default — replace for NXP/TI/Nordic/etc.
# DATASHEET_PERIPHERALS=GPIO,USART,UART,TIM,RCC,SPI,I2C,DMA,NVIC,EXTI,ADC,DAC

# --- Disable register tools entirely (for non-MCU documents like RFCs, books) ---
# DISABLE_REGISTER_TOOLS=1

# --- Embedding model (Hugging Face id) ---
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
